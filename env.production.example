# Se copia a env.production y se le pasa al contenedor con --env-file.
NODE_ENV=production
MONGO_URL=mongodb://mongodb:27017/seminari7
CORS_ORIGIN=http://localhost:4200
SERVER_PORT=1337

# Obligatorios: sin ellos el servidor no arranca.
JWT_SECRET=cambia-esto-por-32-caracteres-aleatorios
JWT_REFRESH_SECRET=cambia-esto-por-otros-32-caracteres-aleatorios
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
